# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 或兼容 API（例如 DeepSeek）
# DEEPSEEK_API_KEY=
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# MCP Server 如需 Bearer Token，请在 Tool 管理页填写这里的变量名
# MCP_API_TOKEN=

# ---- StartLux-Decision 决策闸门（详见 docs/spec-startlux-decision-gate.md）----
# 决策 API key：到 bamboonode.dev/register 注册（免费），填入 .env.local（不要提交）
# STARTLUX_API_KEY=
# 闸门模式：off（默认，闸门不启用）/ mock（本地桩，仅冒烟）/ live_shadow（真实调用只记录不拦截）/ live（真实拦截）
# STARTLUX_GATE_MODE=off
# 二期入口分流模式：off（默认）/ shadow（只记录模型 vs 正则）/ assist（模型∪正则锁 priceTools）
# STARTLUX_INTENT_MODE=off
# 确定性价格预检：on（默认）/ off —— 任何闸门模式下都建议保持 on
# PRICE_CHECK_MODE=on
# 模型 ID（固定版本；升级需重放 fixture 校准）
# STARTLUX_DECISION_MODEL=startlux-decision-27b-autothink
# 分层阈值 JSON（起点值，最终值以 fixture 校准 ADR 为准）
# STARTLUX_THRESHOLDS_JSON={"release":0.55,"forbidden":0.65,"actionConfidence":0.35,"fraudSuspect":0.5,"fraudGuidance":0.9,"noneProbability":0.5}
# 决策 API 超时毫秒（live 实测 always 模式 2-4s，思考触发可达 6s+，默认 12s）
# STARTLUX_GATE_TIMEOUT_MS=15000
# fixture/replay 专用 probe 路由开关（仅本地评测时设 1，勿在生产开启）
# ALLOW_DECISION_PROBE=1
